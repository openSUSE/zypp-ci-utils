#! /bin/bash
# Ensure ssh-agent is running
[ -f ~/.ssh4cron ] && . ~/.ssh4cron
ssh-add -T ~/.ssh/zypp-team-submittkey
RET="$?"
if (( $RET )); then
    if (( $RET == 2 )); then
        echo "*** Start ssh-agent..."
        eval $(ssh-agent)
        rm -f ~/.ssh4cron
        cat << EOF > ~/.ssh4cron
SSH_AGENT_PID=$SSH_AGENT_PID; export SSH_AGENT_PID;
SSH_AUTH_SOCK=$SSH_AUTH_SOCK; export SSH_AUTH_SOCK;
EOF
        chmod 400 ~/.ssh4cron
        . ~/.ssh4cron
    fi
    echo "*** ssh-agent($SSH_AGENT_PID) adding zypp-team-submittkey..."
    export SSH_ASKPASS=/usr/lib/ssh/ssh-askpass
    ssh-add ~/.ssh/zypp-team-submittkey
else
    echo "ssh-agent($SSH_AGENT_PID) has zypp-team-submittkey"
fi
