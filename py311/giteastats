#! /usr/bin/python3
import sys, os, traceback
from tools import *
#======================================================================
def LOG_HEAD( *args ):
    Bprint( "### ######################################################################" )
    Bprint( "###", *args )
    Bprint( "### ######################################################################" )

def LOG_TASK( *args ):
    Bprint( "###", *args )

def LOG_END():
    Bprint( "### ######################################################################" )

def LOG_SEP():
    Bprint( "### ----------------------------------------------------------------------" )

#======================================================================
def usage():
    print(f'''Usage: {os.path.basename(sys.argv[0])} [PKG|PBRANCH]..
''')

#======================================================================
def setup():
    # The directory where gitea-config and oscrc reside
    configsdir      = os.environ['ZCI_USER_CONFIGDIR']
    # Basic command stems for git-obs and obs so they refer to the configs in configsdir
    gitobscmd       = ("git-obs","--gitea-config",f"{configsdir}/gitea-config")
    osccmd          = ("osc","--config",f"{configsdir}/oscrc")
    # Extending the command stems to refer to ibs/obs (build.suse.de/build.opensuse.org)
    # and GitIbs/GitObs (src.suse.de/src.opensuse.org)
    Gitea.USER      = "zypp-team"                       # Owner of the forks GitIbs/GitObs
    GitObs._bscmd   = (*gitobscmd,"-G","obs-zt",)
    GitIbs._bscmd   = (*gitobscmd,"-G","ibs-zt",)
    Obs._bscmd      = (*osccmd,"-A","https://api.opensuse.org")
    Ibs._bscmd      = (*osccmd,"-A","https://api.suse.de" )

    if False: # access check to the 4 instances
        Obs("user").run()
        Ibs("user").run() # for whatever reason IBS does not work for zypp-team, need a true user able to submit
        GitIbs("repo","list","--user",Gitea.USER).run()
        GitObs("repo","list","--user",Gitea.USER).run()

    checkWorkspaceMagic( ".giteastats" )    # Prevent us from doing checkouts at arbitrary CWDs

def main():
    setup()
    fetchDelay = 60 # do git fetch once an hour

    # Configuration for the SubmissionTask(...) calls below (after the help and usage stuff)
    # remotes:
    #   origin - your forks from pool/   (PR source)
    #   parent - pool/ the pool packages (PR target)
    #
    # SubmissionTask(..) checks the intended git branch structure of the configured packages.
    #
    # - Obs-zypp-Head: Represents the intended last submitted version. The possible next version
    #   are the data copied from obsSourcePrj(obs:/zypp:Head) as local changes into the Obs-zypp-Head
    #   checkout. Obs-zypp-Head and origin/Obs-zypp-Head are always in sync. We hard reset Obs-zypp-Head
    #   to origin/Obs-zypp-Head and then copy the data from obsSourcePrj to see whether these are diffs.
    #   ONLY on --submit the local changes are wrapped in to a commit and pushed to origin/Obs-zypp-Head
    #   (as the next release)
    #
    # - Local slfo-* and origin/slfo-* branches. These branches should slavishly follow Obs-zypp-Head
    #   and origin/Obs-zypp-Head. They only exist because the PR review tools expect PR source and target
    #   branches to have the same name. Otherwise We'd PR from origin/Obs-zypp-Head to parent/slfo-*
    #
    # SubmissionTask(..) checks this structure, and determines whether OBS has new data thet could be submitted
    # (new version and changes file). Also checks whether PRs are running (origin/slfo-* != parent/slfo-*) or
    # would need to be filed. All this is stored inside the task structure returned from the call.
    #
    # After all packages and branches are processed, the collect task structures are used to write the SUMMARY,
    # or if --submit is set do the necessary commits to amend runnign PRs or file new ones if needed.
    #
    # NOTE: ATM related with giteaTarget(GitIbs) are the knownPkgs and knownPbranches ON GitIbs. The code
    # processes the matrix of (knownPkgs x knownPbranches). New packages and branches can eb added any time,
    # but there's no mechanism to exclude certain packages from certain branches. This would need to be
    # implemented.
    # In case in the future submissions to GitObs (src.opensuse.org) are needed. You need  knownPkgs and
    # knownPbranches per giteaTarget (GitIbs,gitObs) and call SubmissionTask(...) accordingly. The returned
    # task may shown or submitted in any order (AFAIK ther's no constraint that the tasks must be processed
    # in the order thaty were created)
    obsSourcePrj   = Obs.Prj("zypp:Head")
    giteaTarget    = GitIbs
    knownPkgs      = ( "libsolv", "libzypp", "zypper", "zypp-plugin" )
    knownPbranches = ( "slfo-main", "slfo-1.3", "slfo-1.2", "slfo-1.1", "slfo-1.0" )

    pkgs      = set()
    pbranches = set()
    doSubmit  = False

    for arg in sys.argv[1:]:
        # usage ------------------------------------------------
        if arg == "-h" or arg == "--help":
            print(f'''Usage: {os.path.basename(sys.argv[0])} [--submit] [PKG|PBRANCH]...
Show submission stats for PKGs and PBRANCHes.
Updates local data, but no remote unless --submit.

    --submit     : Commit pending changes to origin and make sure
                   a PR to parent is running.

    obsSourcePrj : {obsSourcePrj}
    giteaTarget  : {giteaTarget.__name__} ({Gitea.USER})
    PKGs         : {" ".join(knownPkgs)}
    PBRANCHes    : {" ".join(knownPbranches)}
''')
            return 0
        # usage ------------------------------------------------

        if arg in knownPkgs:
            pkgs.add( arg )
        elif arg in knownPbranches:
            pbranches.add( arg )
        elif arg == "--submit":
            doSubmit = True
        else:
            raise ValueError( f"Unknown argument: {arg}" )

    if not len(pkgs):
        pkgs = knownPkgs
    if not len(pbranches):
        pbranches = knownPbranches

    stats = []
    for pkg in pkgs:
        task = SubmissionTask( obsSourcePrj, giteaTarget, pkg, fetchDelay=fetchDelay )
        task.updateFromObs()
        task.checkSubmittStatus( pbranches )
        stats.append( task )


    LOG_HEAD( "SUBMIT" if doSubmit else "SUMMARY" )
    somethingToDO = False
    for task in stats:
        task.setFateFromStats()
        if task.summarizeFate():    # somethingToDO
            if doSubmit:
                task.submitFate()
            else:
                somethingToDO = True
    LOG_END()
    return 42 if somethingToDO else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as e:
        Rprint( "OOps:", e )
        Rprint( traceback.format_exc() )
        sys.exit( 13 )
